    "nProxy": {
      "type": "sideapp",
      "id": "nProxy",
      "width": 250,
      "data": {
        "id": "nginx",
        "name": "FP-GEN Public Proxy",
        "image": "534148718950.dkr.ecr.ap-northeast-1.amazonaws.com/ebstudio/asset-library-master/public/github/space/asset-library-master/nginx_v1_29:1.0.2",
        "environment": {
          "envProxyApiUrl": {
            "key": "ENV_FPGEN_API_URL",
            "value": "$[[FPGEN_API_URL]]",
            "_id": "envProxyApiUrl",
            "_order": "a0000"
          }
        },
        "injection": {
          "proxyTemplate": {
            "path": "/app/template.conf",
            "data": "user nginx;\nworker_processes auto;\nevents { worker_connections 1024; }\nhttp {\n  include /etc/nginx/mime.types;\n  default_type application/octet-stream;\n  client_max_body_size 1G;\n  keepalive_timeout 180;\n  proxy_connect_timeout 180s;\n  proxy_send_timeout 180s;\n  proxy_read_timeout 180s;\n\n  server {\n    listen 8080;\n    server_name localhost;\n    port_in_redirect off;\n    absolute_redirect off;\n\n    proxy_set_header Host $http_host;\n    proxy_set_header X-Real-IP $remote_addr;\n    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;\n    proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;\n    proxy_http_version 1.1;\n    proxy_set_header Upgrade $http_upgrade;\n    proxy_set_header Connection \"upgrade\";\n\n    location = / {\n      proxy_pass ${ENV_FPGEN_API_URL}/;\n    }\n\n    location / {\n      proxy_pass ${ENV_FPGEN_API_URL}/;\n    }\n  }\n}\n",
            "_id": "proxyTemplate",
            "_order": "a0000",
            "lang": "nginx"
          }
        },
        "storage": {
          "proxyTempMount": {
            "path": "/tmp/mnt",
            "_id": "proxyTempMount",
            "_order": "a0000"
          }
        },
