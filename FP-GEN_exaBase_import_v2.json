        "text": "Default proposal sections<br>1 Cover Letter<br>2 Project Understanding<br>3 Methodology<br>4 Scope &amp; Deliverables<br>5 Schedule<br>6 Team Structure<br>7 Financial Proposal<br>8 Relevant Experience<br>9 Assumptions &amp; Exclusions",
        "fill": "gray",
        "_order": "a0030"
      },
      "width": 340
    }
  },
  "projectName": "FP-GEN exaBase Import v2",
  "projectId": "fpgen-exabase-v2"
}